    { "name": "raw_complaint", "type": "TEXT", "required": true },
    { "name": "repro_steps", "type": "TEXT", "required": false },
    { "name": "status", "type": "ENUM", "required": true, "default": "Open",
      "options": ["Open", "In_Progress", "Fixed"] }
  ],
  "config": {}
}
