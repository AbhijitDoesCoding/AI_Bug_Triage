{
  "name": "release-notes",
  "description": "When a bug is marked Fixed, drafts a user-facing release note, gets human approval, and saves the approved note back to the bug.",
  "start": {
    "type": "DATASTORE_EVENT",
    "config": {
      "table_name": "bugs",
      "operations": ["UPDATE"]
    }
  },
  "nodes": [
    {
      "id": "check_fixed",
      "type": "DECISION",
      "label": "Fixed and not yet approved?",
      "config": {
        "rules": [
          {
            "condition": "start.payload.status == 'Fixed' && start.payload.release_notes_approved != `true`",
            "next_node_id": "draft_note"
          }
        ]
      }
    },
    {
      "id": "draft_note",
      "type": "AGENT",
      "label": "Draft Release Note",
      "config": {
        "agent_name": "release_writer",
        "input_mapping": {
          "bug_id": { "type": "expression", "value": "start.metadata.record_id" }
        }
      }
    },
    {
      "id": "approval",
      "type": "FORM",
      "label": "Review & Approve Release Note",
      "config": {
        "input_schema": {
          "type": "object",
          "properties": {
            "approved": { "type": "boolean", "title": "Approve this release note?" },
            "edited_note": {
              "type": "string",
              "title": "Release note (edit before approving if needed)",
              "default": { "type": "expression", "value": "draft_note.release_note", "optional": true }
            }
          },
          "required": ["approved"]
        },
        "ui_schema": { "ui:order": ["edited_note", "approved"] }
      }
    },
    {
      "id": "approve_route",
      "type": "DECISION",
      "label": "Approved?",
      "config": {
        "rules": [
          { "condition": "approval.approved == `true`", "next_node_id": "save_note" }
        ]
      }
    },
    {
      "id": "save_note",
      "type": "FUNCTION",
      "label": "Save Approved Note",
      "config": {
        "function_name": "save_release_note",
        "input_mapping": {
          "bug_id": { "type": "expression", "value": "start.metadata.record_id" },
          "note": { "type": "expression", "value": "approval.edited_note" }
        }
      }
    },
    {
      "id": "end",
      "type": "END",
      "label": "Done"
    }
  ],
  "edges": [
    { "id": "e1", "source": "check_fixed", "target": "end", "label": "not fixed / already approved (default)" },
    { "id": "e2", "source": "draft_note", "target": "approval" },
    { "id": "e3", "source": "approval", "target": "approve_route" },
    { "id": "e4", "source": "approve_route", "target": "end", "label": "not approved (default)" },
    { "id": "e5", "source": "save_note", "target": "end" }
  ],
  "visibility": "POD"
}
